{
  "name": "Post-Sales Call Transcript Synthesizer & CRM Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "transcript-completed",
        "options": {}
      },
      "id": "node-transcript-webhook",
      "name": "Gong / Fathom Webhook Ingest",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "model": "claude-3-5-sonnet-latest",
        "prompt": "=Analyze this sales call recording transcript:\n{{ $json.body.transcript }}\n\nExtract and return valid JSON with:\n{\n  \"summary_bullets\": [\"...\"],\n  \"identified_pain\": \"...\",\n  \"budget_timeline\": \"...\",\n  \"competitors_mentioned\": [\"...\"],\n  \"agreed_next_steps\": \"...\",\n  \"deal_health_score\": 1-10,\n  \"followup_email_draft\": \"...\"\n}",
        "options": {}
      },
      "id": "node-claude-synthesize",
      "name": "Claude 3.5 Transcript Synthesizer",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "=https://api.hubapi.com/crm/v3/objects/deals/{{ $('Gong / Fathom Webhook Ingest').item.json.body.deal_id }}",
        "method": "PATCH",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.HUBSPOT_ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"latest_call_summary\": $json.output.summary_bullets.join('\\n'),\n    \"customer_pain_points\": $json.output.identified_pain,\n    \"next_step\": $json.output.agreed_next_steps,\n    \"deal_health\": $json.output.deal_health_score\n  }\n}",
        "options": {}
      },
      "id": "node-hubspot-sync",
      "name": "Patch HubSpot Deal Record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SLACK_SALES_CHANNEL_WEBHOOK }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \":white_check_mark: *Call Synthesized & CRM Updated*: Deal ID {{ $('Gong / Fathom Webhook Ingest').item.json.body.deal_id }}\\n\\n*Follow-up Draft Ready in HubSpot Drafts Box.*\"\n}",
        "options": {}
      },
      "id": "node-slack-rep",
      "name": "Notify Rep in Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Gong / Fathom Webhook Ingest": {
      "main": [
        [
          {
            "node": "Claude 3.5 Transcript Synthesizer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude 3.5 Transcript Synthesizer": {
      "main": [
        [
          {
            "node": "Patch HubSpot Deal Record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Patch HubSpot Deal Record": {
      "main": [
        [
          {
            "node": "Notify Rep in Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
