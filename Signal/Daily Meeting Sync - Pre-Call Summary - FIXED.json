        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filterGroups\": [\n    {\n      \"filters\": [\n        {\n          \"propertyName\": \"hs_meeting_start_time\",\n          \"operator\": \"GTE\",\n          \"value\": \"{{ DateTime.now().setZone('America/Chicago').startOf('day').toMillis() }}\"\n        },\n        {\n          \"propertyName\": \"hs_meeting_start_time\",\n          \"operator\": \"LTE\",\n          \"value\": \"{{ DateTime.now().setZone('America/Chicago').endOf('day').toMillis() }}\"\n        },\n        {\n          \"propertyName\": \"hubspot_owner_id\",\n          \"operator\": \"IN\",\n          \"values\": [\"89038457\",\"90231925\",\"79810165\",\"89636891\",\"732232099\",\"89038474\",\"90305033\",\"754496064\"]\n        },\n        {\n          \"propertyName\": \"hs_activity_type\",\n          \"operator\": \"IN\",\n          \"values\": [\"Demo\",\"Qualification Meeting (SQL)\",\"SQL - Additional Discovery Required\",\"Discovery Stage Meeting\",\"Validation Stage Meeting\",\"Pain Points/Proposal Meeting\",\"MSA Readiness Meeting\",\"SOW Negotiation Meeting\",\"SDR Chatbot Meeting Request\"]\n        }\n      ]\n    }\n  ],\n  \"properties\": [\"hs_meeting_title\",\"hs_meeting_body\",\"hs_meeting_start_time\",\"hs_meeting_end_time\",\"hubspot_owner_id\",\"hs_activity_type\"],\n  \"limit\": 100,\n  \"sorts\": [{ \"propertyName\": \"hs_meeting_start_time\", \"direction\": \"ASCENDING\" }]\n}",
        "options": {}
